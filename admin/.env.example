# =========================================================================
# OMNICHANNEL INVENTORY SYNC HUB CONFIGURATION
# =========================================================================

# Shared Webhook Authorization Secret
# Used to verify incoming triggers from Supabase or inbound marketplace order hooks
INVENTORY_SYNC_WEBHOOK_SECRET="your_shared_webhook_secret_here"

# 1. Meta Commerce Catalog API
# Get catalog ID from Facebook Commerce Manager and Access Token from Business Manager (System User)
META_CATALOG_ID="your_meta_catalog_id"
META_ACCESS_TOKEN="your_meta_system_user_access_token"

# 2. Pinterest Shopping API
PINTEREST_CATALOG_ID="your_pinterest_catalog_id"
PINTEREST_ACCESS_TOKEN="your_pinterest_oauth_access_token"
PINTEREST_AD_ACCOUNT_ID="your_optional_pinterest_ad_account_id"

# 3. Amazon Selling Partner API (SP-API)
# Target Marketplace ID (e.g. Amazon India is A21TJRUUN4KGV)
# SP-API Endpoints:
# - Far East (India, Japan, Australia): https://sellingpartnerapi-fe.amazon.com
# - North America: https://sellingpartnerapi-na.amazon.com
# - Europe: https://sellingpartnerapi-eu.amazon.com
AMAZON_SELLER_ID="your_amazon_seller_merchant_id"
AMAZON_MARKETPLACE_ID="A21TJRUUN4KGV"
AMAZON_SP_API_ENDPOINT="https://sellingpartnerapi-fe.amazon.com"

# Login with Amazon (LWA) OAuth Credentials
AMAZON_LWA_CLIENT_ID="amzn1.application-oa2-client.xxxxxxxxxxxxxxxx"
AMAZON_LWA_CLIENT_SECRET="your_lwa_client_secret"
AMAZON_LWA_REFRESH_TOKEN="your_lwa_refresh_token"

# AWS Credentials (needed to sign requests / execute SP-API calls)
AWS_ACCESS_KEY_ID="AKIAXXXXXXXXXXXXXXXX"
AWS_SECRET_ACCESS_KEY="your_aws_iam_secret_access_key"
AWS_REGION="eu-west-1"

# 4. Flipkart Seller API
FLIPKART_APP_ID="your_flipkart_api_app_id"
FLIPKART_APP_SECRET="your_flipkart_api_app_secret"

# 5. Pepperfry Marketplace Client Stub
PEPPERFRY_API_ENDPOINT="https://api.pepperfry.com/v1/inventory/update"
# 6. Google Merchant Center Promotions API
GOOGLE_MERCHANT_ID="5828116888"
GOOGLE_MERCHANT_SOURCE_ID="10703767031"
GOOGLE_MERCHANT_SOURCE_NAME="Admin app"

# 7. Operations & Email Notifications
OPERATIONS_EMAIL="operations@jamesandsons.in"
NEXT_PUBLIC_ADMIN_URL="https://admin.jamesandsons.in"


