generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CUSTOMER
  B2B_BUYER
  B2B_APPROVER
}

enum CouponType {
  PERCENTAGE    // e.g. 20% off
  FIXED_AMOUNT  // e.g. ₹500 off
  FREE_SHIPPING // waives shipping cost
}

enum CouponStatus {
  ACTIVE
  PAUSED
  EXPIRED
  EXHAUSTED     // usageLimit reached
}

enum AffiliateStatus {
  ACTIVE
  SUSPENDED
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  CANCELLED_PRE_INVOICE
  CANCELLED_POST_INVOICE
  RTO_INITIATED
  RTO_INSPECTED
  RTO_COMPLETED
  RETURN_REQUESTED
  RETURN_INSPECTED
  CREDIT_NOTE_ISSUED
}

enum RFQStatus {
  DRAFT
  SUBMITTED
  REVIEWING
  APPROVED
  REJECTED
  CONVERTED_TO_ORDER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      Role     @default(CUSTOMER)
  permissions String[] @default([])
  phone     String?
  companyId String?
  lastPincode String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  company        Company?       @relation(fields: [companyId], references: [id])
  orders         Order[]
  rfqs           RFQ[]
  tickets         Ticket[]       @relation("UserTickets")
  assignedTickets Ticket[]       @relation("AssignedTickets")
  addresses      UserAddress[]
  ticketMessages TicketMessage[]
  ticketAuditLogs TicketAuditLog[]
 
  blogPosts   BlogPost[]
  dynamicCoupons DynamicCoupon[]
  pushSubscriptions PushSubscription[]
}

model Company {
  id              String   @id @default(uuid())
  name            String
  gstin           String?
  billingAddress  String?
  shippingAddress String?
  parentId        String?  // For Parent-Subsidiary hierarchy
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
 
  parent          Company?  @relation("CompanyHierarchy", fields: [parentId], references: [id])
  subsidiaries    Company[] @relation("CompanyHierarchy")
  users           User[]
}

model Category {
  id                  String     @id @default(uuid())
  name                String
  slug                String     @unique
  description         String?
  parentId            String?
  image               String?    // Primary category cover photo
  images              String[]   @default([]) // Multiple category cover photos
  
  // Compliance and tax details managed centrally
  technicalSubheading String?
  hsnCode             String?
  gstRate             Float?     @default(18.0)
  bisStandard         String?
  bisStatus           String?
  
  // Custom shipping rules
  baseShippingLimit     Float?     @default(280.0)
  freeShippingThreshold Float?     @default(380.0)

  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
}

model Product {
  id               String   @id @default(uuid())
  sku              String   @unique
  name             String
  slug             String   @unique
  description      String
  
  // Pricing
  mrp              Float
  d2cPrice         Float
  b2bPrice         Float    // Base B2B price, can be tiered later
  
  // Specs (structured)
  isLed            Boolean  @default(false)
  luminousEfficacy Float?   // lm/W
  cri              Int?     // Color Rendering Index
  hsnCode          String?
  gstRate          Float    @default(18.0) // 5% for LED, 18% for traditional
  bisCertification String?  // IS 10322 etc.
  
  // New fields from CSV
  dimensions        String?  // Dimensions
  materialAndFinish String[] // Material & Finish
  bulbType          String[] // Bulb Type
  style             String[] // Style
  
  specs            Json?    // Dynamic key-value technical specs for filtering
  customAttributes Json?    // Configurable dynamic attributes for any vertical (Option A)
  
  // Media
  images           String[]
  whiteBackgroundImages String[]
  glbModelUrl      String?
  
  // Inventory
  stockQuantity    Int      @default(0)
  weight           Float?   // in kg
  length           Float?   // in cm
  breadth          Float?   // in cm
  height           Float?   // in cm
  
  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id])
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
 
  // Actual Product Dimensions (for display/filtering)
  actualHeight     Float?   // in inches
  actualWidth      Float?   // in inches
  actualDepth      Float?   // in inches
  dimensionUnit    String   @default("INCH")

  // Additional listing fields for platforms (Amazon, Flipkart, Indiamart, Meta, Pinterest)
  power                 String?
  voltage               String?
  googleProductCategory String?
  color                 String?
  size                  String?
  material              String?
  countryOfOrigin       String?
  brand                 String?
  warranty              String?
  bulletPoints          String[]
 
  // Amazon SEO Overrides
  amazonFixtureForm        String?
  amazonMountingType       String?
  amazonLightingMethod     String?
  amazonWaterResistance    String?
  amazonTheme              String?
  amazonSpecialFeatures    String[]
  amazonIncludedComponents String?
  amazonKeywords           String?

  spaces           Space[]
  variants         ProductVariant[]
  orderItems       OrderItem[]
  rfqItems         RFQItem[]
}

model ProductVariant {
  id            String   @id @default(uuid())
  productId     String
  name          String   // e.g. "Gold – 48 inch"
  sku           String   @unique
  d2cPrice      Float?   // Overrides parent if set
  mrp           Float?
  b2bPrice      Float?
  stockQuantity Int      @default(0)
  images        String[]
  whiteBackgroundImages String[]
  weight        Float?   // in kg
  length        Float?   // in cm
  breadth       Float?   // in cm
  height        Float?   // in cm
  
  actualHeight  Float?   // in inches
  actualWidth   Float?   // in inches
  actualDepth   Float?   // in inches
  dimensionUnit String   @default("INCH")

  // Additional listing and override fields
  power                 String?
  voltage               String?
  googleProductCategory String?
  color                 String?
  size                  String?
  material              String?
  countryOfOrigin       String?
  brand                 String?
  warranty              String?
  bulletPoints          String[]
  materialAndFinish     String[]
  bulbType              String[]
  style                 String[]
  specs                 Json?
 
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
 
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id             String      @id @default(uuid())
  orderNumber    String      @unique
  invoiceNumber  String?     @unique
  userId         String
  status         OrderStatus @default(PENDING)
  
  totalAmount    Float
  taxAmount      Float
  shippingAmount Float
  discountAmount Float       @default(0)   // Actual INR amount discounted
  couponCode     String?                   // Denormalized for quick display
  affiliateCode  String?                   // Denormalized for quick display
  
  shippingAddress String
  shippingPhone   String?
  shippingCity    String?
  shippingState   String?
  shippingPincode String?
  billingAddress  String
  gstin           String?
  companyName     String?
  
  trackingNumber String?
  awbNumber      String?     // For logistics (Shiprocket/Delhivery)
  irn            String?     // E-Invoicing Reference Number
  
  razorpayOrderId   String?  @unique
  razorpayPaymentId String?
  razorpaySignature String?
  
  fulfillmentError  String?  // Logs errors from Shiprocket/Logistics

  // Amazon Marketplace fields
  channel              String?  @default("JNS_STOREFRONT")  // JNS_STOREFRONT | AMAZON | FLIPKART
  amazonOrderId        String?  @unique                      // e.g. 403-1234567-1234567
  amazonOrderStatus    String?                               // Unshipped | Shipped | Cancelled
  amazonShipmentFeedId String?                               // Feed submission ID after confirm-shipment
  amazonReviewSolicited   Boolean   @default(false)
  amazonReviewSolicitedAt DateTime?

  
  b2bFlag             Boolean   @default(false)
  zohoPricebookId     String?
  zohoSalesOrderId    String?
  onsitegoCertificateUrl String?
  ucTicketId          String?
  ucInstallationStatus String    @default("NONE")
  ucInstallationSlot   String?

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
 
  user                User                 @relation(fields: [userId], references: [id])
  items               OrderItem[]
  returnRequests      ReturnRequest[]
  tickets             Ticket[]
  couponUsage         CouponUsage?
  affiliateConversion AffiliateConversion?
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String
  variantId String?  // optional – links to a specific variant
  quantity  Int
  unitPrice Float
  total     Float
  
  // Onsitego Warranty Selection
  warrantyPlanSku  String?
  warrantyPlanName String?
  warrantyPrice    Float?
  
  order     Order    @relation(fields: [orderId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
}

model ReturnRequest {
  id               String       @id @default(uuid())
  orderId          String
  reason           String
  status           ReturnStatus @default(PENDING)
  adminNote        String?
  
  // New Shiprocket fields for reverse logistics
  awbNumber        String?      // AWB code assigned to return pickup
  shipmentId       String?      // Shiprocket Shipment ID for return
  labelUrl         String?      // URL of the generated return label PDF
  fulfillmentError String?      // Logs error if return sync/label creation fails
  
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
 
  order            Order        @relation(fields: [orderId], references: [id])
}

model RFQ {
  id             String    @id @default(uuid())
  rfqNumber      String    @unique
  userId         String
  status         RFQStatus @default(DRAFT)
  
  channel        String?   @default("STOREFRONT_RFQ")
  projectName    String?
  timeline       String?
  notes          String?
  validUntil     DateTime?
  discountAmount Float?    @default(0)
  taxAmount      Float?    @default(0)
  shippingAmount Float?    @default(0)
  totalAmount    Float?
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
 
  user        User      @relation(fields: [userId], references: [id])
  items       RFQItem[]
}

model RFQItem {
  id            String   @id @default(uuid())
  rfqId         String
  productId     String
  quantity      Int
  targetPrice   Float?   // Optional target price requested by buyer
  approvedPrice Float?   // Approved unit price offered by admin
  customSpecs   Json?    // Finish, drop height, voltage requirements
  
  rfq         RFQ      @relation(fields: [rfqId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])
}

model Ticket {
  id           String       @id @default(uuid())
  ticketNumber String       @unique
  userId       String
  orderId      String?
  subject      String
  description  String
  status       TicketStatus @default(OPEN)
  category     String       @default("GENERAL")
  priority     String       @default("MEDIUM")
  attachments  String[]
  orderItems   Json?
  zohoId       String?      @unique
  readByAdmin  Boolean      @default(true)
  assignedToId String?
  
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
 
  user         User         @relation("UserTickets", fields: [userId], references: [id])
  assignedTo   User?        @relation("AssignedTickets", fields: [assignedToId], references: [id])
  order        Order?       @relation(fields: [orderId], references: [id])
  ticketMessages TicketMessage[]
  auditLogs    TicketAuditLog[]
}

model TicketMessage {
  id                  String   @id @default(uuid())
  ticketId            String
  authorId            String
  message             String
  isAdmin             Boolean  @default(false)
  isInternalNote      Boolean  @default(false)
  attachments         String[]
  zohoId              String?  @unique
  externalMessageId   String?  @unique  // Stores outbound email Message-ID or inbound email Message-ID for dedup

  createdAt DateTime @default(now())

  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])
}

model Page {
  id              String   @id @default(uuid())
  slug            String   @unique
  title           String
  content         String   @db.Text
  metaTitle       String?
  metaDescription String?
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BlogPost {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  excerpt     String?
  content     String   @db.Text
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  featuredImg String?  // URL to image stored in Supabase storage
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  metaTitle   String?
  metaDesc    String?
  geoTakeaway String?  @db.Text
  faq         Json?
  citations   Json?
  isDraft     Boolean  @default(true)
}

model Space {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  images      String[] @default([])
 
  products    Product[]
 
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InvoiceCounter {
  id        Int      @id @default(1)
  year      String   // e.g. "2026-27"
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model AbandonedCart {
  id          String   @id @default(uuid())
  email       String   @unique
  phone       String?
  cartData    Json     // Items and amounts
  step        Int      @default(1)
  lastSeen    DateTime @default(now())
  recovered   Boolean  @default(false)
  nudgeSent   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────────────────────────
// PROMOTIONS ENGINE
// ─────────────────────────────────────────────
 
model Coupon {
  id                String       @id @default(uuid())
  code              String       @unique  // Human-readable e.g. "LUXE20"
  description       String?               // Internal admin note
  type              CouponType   @default(PERCENTAGE)
  value             Float                 // 20 (percent) or 500 (INR)
  status            CouponStatus @default(ACTIVE)
 
  // Constraints
  minOrderAmount    Float?                // Minimum cart subtotal to apply
  maxDiscountCap    Float?                // Max discount INR (for % coupons)
  usageLimit        Int?                  // Total uses across all users
  usageLimitPerUser Int?    @default(1)   // Times one user can use this code
  usedCount         Int     @default(0)
 
  // Validity window
  startsAt          DateTime?             // Optional future start date
  expiresAt         DateTime?
 
  // Attribution — link to external partner or affiliate
  source            String?               // "internal" | "pauket" | "coupondunia"
  affiliateId       String?
  affiliate         Affiliate?   @relation(fields: [affiliateId], references: [id])
 
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
 
  usages            CouponUsage[]
}
 
model CouponUsage {
  id             String   @id @default(uuid())
  couponId       String
  userId         String?           // null for guest checkouts
  orderId        String   @unique
  discountAmount Float             // Actual INR amount discounted on this order
  createdAt      DateTime @default(now())
 
  coupon         Coupon   @relation(fields: [couponId], references: [id])
  order          Order    @relation(fields: [orderId], references: [id])
}
 
model Affiliate {
  id              String          @id @default(uuid())
  name            String
  email           String          @unique
  phone           String?
  affiliateCode   String          @unique  // URL param: ?ref=DESIGNERSTUDIO
  commissionRate  Float           @default(5.0)  // % of order subtotal
  status          AffiliateStatus @default(ACTIVE)
  notes           String?
 
  // Running lifetime totals (updated on each conversion)
  totalRevenue    Float           @default(0)
  totalCommission Float           @default(0)
 
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
 
  coupons         Coupon[]
  conversions     AffiliateConversion[]
}
 
model AffiliateConversion {
  id               String    @id @default(uuid())
  affiliateId      String
  orderId          String    @unique
  orderRevenue     Float               // Subtotal of the attributed order
  commissionAmount Float               // commission earned on this order
  isPaid           Boolean   @default(false)
  paidAt           DateTime?
 
  createdAt        DateTime  @default(now())
 
  affiliate        Affiliate @relation(fields: [affiliateId], references: [id])
  order            Order     @relation(fields: [orderId], references: [id])
}
 
model UserAddress {
  id              String   @id @default(uuid())
  userId          String
  name            String   // e.g. "Home", "Office"
  street          String
  city            String
  state           String
  pincode         String
  phone           String?
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
 
  user            User     @relation(fields: [userId], references: [id])
}

model OnsitegoMapping {
  id              String   @id @default(uuid())
  minPrice        Float
  maxPrice        Float
  onsitegoPlanSku String   @unique
  planName        String
  coverageYears   Int      @default(1)
  planPriceD2c    Float
  createdAt       DateTime @default(now())

  @@map("onsitego_mappings")
}

model UcServiceMapping {
  id                  String   @id @default(uuid())
  sku                 String   @unique
  ucServiceId         String
  technicianCount     Int      @default(1)
  weightCategory      String
  estimatedSetupHours Float    @default(2.0)
  createdAt           DateTime @default(now())

  @@map("uc_service_mappings")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum CampaignStage {
  STAGE_1_DISPATCH
  STAGE_2_EXPIRY_WARNING
}

model IndianHoliday {
  id        String     @id @default(uuid())
  name      String
  date      DateTime
  isMajor   Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  campaigns Campaign[]

  @@map("indian_holidays")
}

model Campaign {
  id                 String          @id @default(uuid())
  holidayId          String?
  name               String
  status             CampaignStatus  @default(DRAFT)
  stage              CampaignStage   @default(STAGE_1_DISPATCH)
  segmentationRules  Json            // e.g. { segment: "VIP" | "LAPSED" | "ALL", discountValue: 15 }
  metrics            Json            // e.g. { sentCount: 0, openCount: 0, redeemedCount: 0, totalRevenue: 0 }
  emailSubject       String?
  emailBodyHtml      String?         @db.Text
  whatsappText       String?         @db.Text
  recommendedProducts Json?          // Array of top 4 product objects/IDs selected by AI
  scheduledAt        DateTime?
  sentAt             DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  holiday            IndianHoliday?  @relation(fields: [holidayId], references: [id])
  dynamicCoupons     DynamicCoupon[]

  @@map("campaigns")
}

model CampaignTemplate {
  id         String   @id @default(uuid())
  name       String
  htmlLayout String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("campaign_templates")
}

model DynamicCoupon {
  id            String    @id @default(uuid())
  campaignId    String
  customerId    String?
  uniqueCode    String    @unique // 8-char alphanumeric code (e.g. DIWALI8X)
  discountValue Float     @default(15)
  isRedeemed    Boolean   @default(false)
  redeemedAt    DateTime?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())

  campaign      Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer      User?     @relation(fields: [customerId], references: [id])

  @@map("dynamic_coupons")
}

model Catalogue {
  id          String   @id @default(uuid())
  title       String
  description String?
  year        Int      @default(2025)
  coverImage  String?  // URL to cover image (Cloudinary or direct)
  fileUrl     String   // URL to downloadable PDF
  isPublished Boolean  @default(false)
  downloads   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("catalogues")
}

model TicketAuditLog {
  id         String   @id @default(uuid())
  ticketId   String
  actorId    String
  actionType String   // e.g., "ASSIGNED", "STATUS_CHANGE", "PRIORITY_CHANGE", "INTERNAL_NOTE"
  details    String?  // e.g., "Assigned to James", "Status set to Resolved"
  createdAt  DateTime @default(now())

  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor      User     @relation(fields: [actorId], references: [id])

  @@map("ticket_audit_logs")
}

enum InquiryStatus {
  NEW
  CONTACTED
  ARCHIVED
}

model Inquiry {
  id        String        @id @default(uuid())
  email     String
  name      String?
  subject   String
  message   String
  recipient String        // e.g. "sales@jamesandsons.in" or "connect@jamesandsons.in"
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @default(now()) @updatedAt

  @@map("inquiries")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_subscriptions")
}

model ShippingRule {
  id                    String   @id @default("GLOBAL")
  baseShippingLimit     Float    @default(280.0)
  freeShippingThreshold Float    @default(380.0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("shipping_rules")
}

model SystemConfig {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_configs")
}

model FinancialPeriod {
  id          String    @id @default(uuid())
  periodCode  String    @unique // e.g. "2026-04"
  startDate   DateTime
  endDate     DateTime
  isClosed    Boolean   @default(false)
  closedAt    DateTime?
  closedBy    String?
  createdAt   DateTime  @default(now())

  invoices    Invoice[]

  @@map("financial_periods")
}

model Invoice {
  id                 String           @id @default(uuid())
  invoiceNumber      String           @unique
  orderId            String
  financialPeriodId  String?
  billingName        String
  billingGstin       String?
  shippingState      String
  placeOfSupplyCode  String           // e.g. "09"
  isB2B              Boolean          @default(false)
  irn                String?          @unique
  irnStatus          String           @default("GENERATED") // GENERATED, CANCELLED
  irnGeneratedAt     DateTime?
  subtotalAmount     Float
  discountAmount     Float            @default(0.0)
  shippingAmount     Float            @default(0.0)
  cgstAmount         Float            @default(0.0)
  sgstAmount         Float            @default(0.0)
  igstAmount         Float            @default(0.0)
  totalTaxAmount     Float            @default(0.0)
  totalInvoiceAmount Float
  isLocked           Boolean          @default(false)
  lockedAt           DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  financialPeriod    FinancialPeriod? @relation(fields: [financialPeriodId], references: [id])
  creditNotes        CreditNote[]

  @@map("invoices")
}

model CreditNote {
  id                    String           @id @default(uuid())
  creditNoteNumber      String           @unique
  invoiceId             String
  orderId               String
  reason                String           // PRE_DISPATCH_CANCEL, RTO, CUSTOMER_RETURN, DEFECTIVE
  creditNoteType        String           @default("GST_TAX") // GST_TAX or COMMERCIAL_NON_GST
  irn                   String?          @unique
  irnStatus             String?
  subtotalReversed      Float
  cgstReversed          Float            @default(0.0)
  sgstReversed          Float            @default(0.0)
  igstReversed          Float            @default(0.0)
  totalTaxReversed      Float            @default(0.0)
  totalCreditNoteAmount Float
  section34Compliant    Boolean          @default(true)
  issuedAt              DateTime         @default(now())
  gstr1FilingPeriod     String?          // YYYY-MM

  invoice               Invoice          @relation(fields: [invoiceId], references: [id])
  items                 CreditNoteItem[]
  refunds               Refund[]

  @@map("credit_notes")
}

model CreditNoteItem {
  id               String     @id @default(uuid())
  creditNoteId     String
  productId        String
  variantId        String?
  hsnCode          String
  quantityReturned Int
  unitPrice        Float
  taxableValue     Float
  taxRate          Float      @default(18.0)
  cgstAmount       Float      @default(0.0)
  sgstAmount       Float      @default(0.0)
  igstAmount       Float      @default(0.0)
  createdAt        DateTime   @default(now())

  creditNote       CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  @@map("credit_note_items")
}

model Refund {
  id                 String      @id @default(uuid())
  orderId            String
  creditNoteId       String?
  gatewayName        String      // RAZORPAY, AMAZON_PAY, CASH_ON_DELIVERY
  gatewayRefundId    String?     @unique
  gatewayPaymentId   String
  refundAmount       Float
  gatewayFeeDeducted Float       @default(0.0)
  gatewayGstOnFee    Float       @default(0.0)
  tcsReversedAmount  Float       @default(0.0)
  status             String      @default("INITIATED") // INITIATED, PROCESSED, FAILED
  processedAt        DateTime?

  creditNote         CreditNote? @relation(fields: [creditNoteId], references: [id])

  @@map("refunds")
}

model InventoryQuarantine {
  id           String    @id @default(uuid())
  orderId      String
  productId    String
  variantId    String?
  quantity     Int
  sourceType   String    // RTO, CUSTOMER_RETURN
  qcStatus     String    @default("PENDING_INSPECTION") // PENDING_INSPECTION, PASSED_RESTOCKED, DAMAGED_SCRAPPED
  inspectedBy  String?
  inspectedAt  DateTime?
  notes        String?

  @@map("inventory_quarantine")
}

model AttributeDefinition {
  id           String   @id @default(uuid())
  name         String
  key          String   @unique
  type         String   // STRING, NUMBER, BOOLEAN, SELECT
  options      String[] @default([])
  isFilterable Boolean  @default(true)
  isRequired   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("attribute_definitions")
}

model TenantCredential {
  id          String   @id @default(uuid())
  service     String   @unique // RAZORPAY, SHIPROCKET, ZOHO, CLOUDINARY, RESEND
  credentials Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tenant_credentials")
}

model TenantDictionary {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  group     String   @default("common")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tenant_dictionary")
}

model CmsSection {
  id         String   @id @default(uuid())
  page       String
  sectionKey String   @unique
  title      String?
  content    Json
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("cms_sections")
}



